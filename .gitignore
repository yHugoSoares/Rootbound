# OS
.DS_Store
._*

# dotnet tooling for the pure-core test project (keep source, ignore outputs)
!Tools/**/*.csproj
Tools/**/bin/
Tools/**/obj/
Tools/**/TestResults/

# Photon / local credentials — never commit
*.fusionappid
secrets/
.env

# Fusion settings asset holds the App ID. Photon treats App IDs as client-side
# (non-secret), but project policy keeps credentials out of version control, so
# each developer populates this locally after import.
Assets/Photon/Fusion/Resources/PhotonAppSettings.asset
Assets/Photon/Fusion/Resources/PhotonAppSettings.asset.meta
